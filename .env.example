# ══════════════════════════════════════════════════════════
#  CommitPulse — Environment Variables Template
# ══════════════════════════════════════════════════════════
#
#  HOW TO USE:
#  1. Copy this file:   cp .env.example .env.local
#  2. Fill in the values in .env.local
#  3. NEVER commit .env.local — it is already in .gitignore
#
# ══════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────
#  REQUIRED
# ──────────────────────────────────────────────────────────

# GitHub Personal Access Token (classic)
#
# ⚠️  Variable name is GITHUB_PAT — not GITHUB_TOKEN.
#    GITHUB_TOKEN is reserved by GitHub Actions for workflow tokens.
#    Using GITHUB_TOKEN here will cause silent 401 Unauthorized errors.
#
# Scopes required:  read:user  (that's it — no write access needed)
#
# How to generate:
#   1. Go to: https://github.com/settings/tokens/new
#   2. Give it a name (e.g. "commitpulse-local")
#   3. Set expiration (90 days recommended)
#   4. Check only the "read:user" scope
#   5. Click "Generate token"
#   6. Copy and paste it below
#
GITHUB_PAT=ghp_your_token_here


# ──────────────────────────────────────────────────────────
#  OPTIONAL — Development only
# ──────────────────────────────────────────────────────────

# Allowed dev origins for cross-origin requests during local development.
# Only needed if you access the dev server from another device
# on your local network (e.g. testing on a phone).
#
# Comma-separated list of IPs or hostnames.
# Example: ALLOWED_DEV_ORIGINS=192.168.1.100,192.168.1.101
#
# ALLOWED_DEV_ORIGINS=
